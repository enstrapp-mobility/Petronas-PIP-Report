<mvc:View xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:ta="sap.ui.table" xmlns:mvc="sap.ui.core.mvc"
	controllerName="ZEMT_AM_PIP_APP.controller.PIP_Ageing_Report_Main">
	<App>
		<pages>
			<Page id="page" showHeader="false">
				<content>
					<OverflowToolbar class="homePageToolBar">
						<Image src="./images/petronasLogo.png" class="logo"></Image>
						<ToolbarSpacer />
						<VBox>
							<Text text="{i18n>ApplicationTitle}" class="headerText"
								id="App_Title" />
							<Text text="" id="logged_user"
								class="UserText sapUiTinyMarginTop sapUiTinyMarginBegin" />
						</VBox>
						<ToolbarSpacer />
						<Button icon="sap-icon://decline" text="{i18n>btn_Exit}"
							press="ExitAction" class="buttonClass" type="Reject"></Button>
						<Button icon="sap-icon://save" text="{i18n>btn_Save}"
							visible="false" id="Save_btn" press="on_Save" class="buttonClass"
							type="Accept"></Button>
					</OverflowToolbar>
					<ScrollContainer height="85%" width="100%"
						vertical="true" focusable="true">
						<ta:Table id="Pip_Ageing_Report_Table"
							selectionMode="None" alternateRowColors="true"
							fixedColumnCount="3" rows="{/}" enableColumnReordering="true"
							ariaLabelledBy="title">
							<ta:extension>
								<OverflowToolbar>
									<Button icon="sap-icon://download"
										tooltip="{i18n>ExcelDownload}" text="{i18n>ExcelDownload}"
										press="onExport" class="buttonClass" type="Transparent"></Button>
									<ToolbarSpacer />
									<Button icon="sap-icon://multi-select" text="Layout"
										visible="false" press="AssetRequestsColumnsPopoverPress"
										tooltip="Layout" type="Transparent" class="TransparentBtn" />

									<Button icon="sap-icon://refresh" press="ReferehData"
										visible="false" text="{i18n>btn_Refresh}"
										tooltip="{i18n>btn_Refresh}" type="Transparent"
										class="TransparentBtn" />

									<Button icon="sap-icon://search"
										text="{i18n>btn_Search}" press="Search_Records"
										tooltip="Search" type="Transparent" class="TransparentBtn" />



								</OverflowToolbar>
							</ta:extension>
							<ta:columns>
								<ta:Column width="10rem" filterProperty="Pspid"
									sortProperty="Pspid">
									<Label text="{i18n>CompanyCode}" design="Bold" />
									<ta:template>
										<ObjectIdentifier title="{Bukrs}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="9rem" filterProperty="Anln1"
									sortProperty="Anln1">
									<Label text="{i18n>PIPAssetNumber}" design="Bold" />
									<ta:template>
										<ObjectIdentifier title="{Anln1}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="7rem" filterProperty="Anln2"
									sortProperty="Anln2">
									<Label text="{i18n>SubAsset}" design="Bold" />
									<ta:template>
										<ObjectIdentifier title="{Anln2}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="10rem" filterProperty="Txt50"
									sortProperty="Txt50">
									<Label text="{i18n>PIPAssetName}" design="Bold" />
									<ta:template>
										<Text text="{Txt50}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="7rem" filterProperty="Anlkl"
									sortProperty="Anlkl">
									<Label text="{i18n>AssetClass}" design="Bold" />
									<ta:template>
										<Text text="{Anlkl}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="20rem" filterProperty="Txk50"
									sortProperty="Txk50">
									<Label text="{i18n>AssetClassName}" design="Bold" />
									<ta:template>
										<Text text="{Txk50}" />
									</ta:template>
								</ta:Column>
								
								<ta:Column width="12rem" filterProperty="Posid"
									sortProperty="Posid">
									<Label text="{i18n>WbsNo}" design="Bold" />
									<ta:template>
										<Text text="{Posid}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="11rem" filterProperty="Wbsname"
									sortProperty="Wbsname">
									<Label text="{i18n>WbsName}" design="Bold" />
									<ta:template>
										<Text text="{Wbsname}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Pspid"
									sortProperty="Pspid">
									<Label text="{i18n>Project}" design="Bold" />
									<ta:template>
										<Text text="{Pspid}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Fyear"
									sortProperty="Fyear">
									<Label text="{i18n>PSCID}" design="Bold" />
									<ta:template>
										<Text text="{Zpscid}" />
									</ta:template>
								</ta:Column>

								<ta:Column width="8rem" filterProperty="Fyear"
									sortProperty="Fyear">
									<Label text="{i18n>Jointventure}" design="Bold" />
									<ta:template>
										<Text text="{Vname}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Prjcost"
									sortProperty="Prjcost">
									<Label text="{i18n>ProjectCost}" design="Bold"  wrapping = "true"/>
									<ta:template>
										<Text text="{Prjcost}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="12rem" filterProperty="Wert1"
									sortProperty="Wert1">
									<Label text="{i18n>ApprovedBudgetforFY}" design="Bold" wrapping = "true"/>
									<ta:template>
										<Text text="{Pwf05}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="15rem" filterProperty="Rprjcost"
									sortProperty="Rprjcost">
									<Label text="{i18n>ApprovedRevisedProjectCost}"
										wrapping = "true" design="Bold" />
									<ta:template>
										<Text text="{Rprjcost}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="15rem" filterProperty="Pwf06"
									sortProperty="Pwf06">
									<Label text="{i18n>Currentyearbalance}"
										wrapping = "true" design="Bold" />
									<ta:template>
										<Text text="{Pwf06}" />
									</ta:template>
								</ta:Column>
								<!-- <ta:Column width="15rem" filterProperty="Pwf05"
									sortProperty="Pwf05">
									<Label text="{i18n>Previousyear}"
										wrapping = "true" design="Bold" />
									<ta:template>
										<Text text="{Pwf05}" />
									</ta:template>
								</ta:Column> -->
								<ta:Column width="10rem" filterProperty="Answt"
									sortProperty="Answt">
									<Label text="{i18n>PIPBalance}" design="Bold" wrapping = "true"/>
									<ta:template>
										<Text text="{Answt}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Yepcost"
									sortProperty="Yepcost">
									<Label text="{i18n>YEP}" design="Bold" />
									<ta:template>
										<Text text="{Yepcost}" />
									</ta:template>
								</ta:Column>
								
								<ta:Column width="12rem" filterProperty="Aktiv"
									sortProperty="Rcompd">
									<Label text="{i18n>Capitalizedon}" design="Bold" />
									<ta:template>
										<Text
											text=" {path: 'Aktiv', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								
								<ta:Column width="8rem" filterProperty="Repdate"
									sortProperty="Repdate">
									<Label text="{i18n>ReportingDate}" design="Bold" />
									<ta:template>
										<Text
											text="{path: 'Repdate', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="10rem">
									<Label text="{i18n>StartingDate(FirstSettlement)}"
										design="Bold" required="false" wrapping="true" />
									<ta:template>
									<Text
											text="{path: 'Pipsdatestt', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="10rem">
									<Label text="{i18n>StartingDate(Adjusted)}" design="Bold"
										required="false" wrapping="true" />
									<ta:template>
									<Text
											text="{path: 'Pipsdateadj', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="9rem" filterProperty="Compd"
									sortProperty="Compd">
									<Label text="{i18n>CompletionDate}" design="Bold" />
									<ta:template>
										<Text
											text="{path: 'Compd', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="12rem" filterProperty="Rcompd"
									sortProperty="Rcompd">
									<Label text="{i18n>RevisedCompletionDate}" design="Bold" />
									<ta:template>
										<Text
											text=" {path: 'Rcompd', formatter: 'ZEMT_AM_PIP_APP.Format.Formatter.formatddmmyyy'}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="9rem" filterProperty="Prozs"
									sortProperty="Prozs">
									<Label text="{i18n>PercentageofCompletion(%)}"
										design="Bold" />
									<ta:template>
										<Text text="{Prozs}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="7rem" filterProperty="Pstatus"
									sortProperty="Pstatus">
									<Label text="{i18n>Status}" design="Bold" />
									<ta:template>
										<Text text="{Pstatus}" />
									</ta:template>
								</ta:Column>

								<ta:Column width="7rem" filterProperty="Dageing"
									sortProperty="Dageing">
									<Label text="{i18n>Ageing}" design="Bold" />
									<ta:template>
										<Text text="{Dageing}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="30rem" filterProperty="Pipctprog"
									sortProperty="Pipctprog">
									<Label text="{i18n>CurrentProgress}" design="Bold" />
									<ta:template>
									 <ExpandableText text="{Pipctprog}"  maxCharacters="100" overflowMode="InPlace"/>
									</ta:template>
								</ta:Column>
								<ta:Column width="30rem" filterProperty="Pipremarks"
									sortProperty="Pipremarks">
									<Label text="{i18n>Remarks}" design="Bold" />
									<ta:template>
										<!-- <Button text = "Show Remarks" press = "on_Current_Progress_Remarks_View"></Button> -->
										<ExpandableText text="{Pipremarks}"  maxCharacters="100" overflowMode="InPlace"/>
									</ta:template>
								</ta:Column>
								<ta:Column width="7rem" filterProperty="Werks"
									sortProperty="Werks">
									<Label text="{i18n>Planningplant}" design="Bold" />
									<ta:template>
										<Text text="{Werks}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="10rem" filterProperty="Kostl"
									sortProperty="Kostl">
									<Label text="{i18n>CostCenter}" design="Bold" />
									<ta:template>
										<Text text="{Kostl}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Ord44"
									sortProperty="Ord44">
									<Label text="{i18n>EvaluationGroup4}" design="Bold" />
									<ta:template>
										<Text text="{Ord44}" />
									</ta:template>
								</ta:Column>
								<ta:Column width="8rem" filterProperty="Atrnid"
									sortProperty="Atrnid">
									<Label text="{i18n>RequestId}" design="Bold" />
									<ta:template>
										<Text text="{Atrnid}" />
									</ta:template>
								</ta:Column>

								<ta:Column width="8rem" filterProperty="Fyear"
									sortProperty="Fyear">
									<Label text="{i18n>FinancialYear}" design="Bold" />
									<ta:template>
										<Text text="{Fyear}" />
									</ta:template>
								</ta:Column>

							

								<!-- <ta:Column width="8rem" filterProperty="Fyear" sortProperty="Fyear"> 
									<Label text="{i18n>NBV}" design="Bold" /> <ta:template> <Text text="{Netbv}" 
									/> </ta:template> </ta:Column> <ta:Column width="8rem" filterProperty="Fyear" 
									sortProperty="Fyear"> <Label text="{i18n>AccountDeterm}" design="Bold" /> 
									<ta:template> <Text text="{Ktogr}" /> </ta:template> </ta:Column> -->

							</ta:columns>
						</ta:Table>
						<DatePicker id="HiddenDP" hideInput="true"
							showCurrentDateButton="true" showFooter="false"
							valueFormat="dd-MMM-yyyy" change="changeDateHandler" />
					</ScrollContainer>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>